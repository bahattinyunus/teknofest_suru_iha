<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="teknofest_arena">
    <!-- Scene lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Competition Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>15</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Corner Pylon 1 (North-East) -->
    <model name="pylon_ne">
      <static>true</static>
      <pose>50 50 2.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.9 1 1</ambient>
            <diffuse>0 0.9 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner Pylon 2 (North-West) -->
    <model name="pylon_nw">
      <static>true</static>
      <pose>-50 50 2.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.9 1 1</ambient>
            <diffuse>0 0.9 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner Pylon 3 (South-West) -->
    <model name="pylon_sw">
      <static>true</static>
      <pose>-50 -50 2.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.9 1 1</ambient>
            <diffuse>0 0.9 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner Pylon 4 (South-East) -->
    <model name="pylon_se">
      <static>true</static>
      <pose>50 -50 2.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0 0.9 1 1</ambient>
            <diffuse>0 0.9 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Tower Alpha -->
    <model name="obstacle_tower_alpha">
      <static>true</static>
      <pose>15 10 5.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.2</radius><length>10.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.2</radius><length>10.0</length></cylinder>
          </geometry>
          <material>
            <ambient>1 0.2 0.2 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Tower Beta -->
    <model name="obstacle_tower_beta">
      <static>true</static>
      <pose>-20 -15 5.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>1.2</radius><length>10.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.2</radius><length>10.0</length></cylinder>
          </geometry>
          <material>
            <ambient>1 0.2 0.2 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Competition Ground Target QR-Alpha -->
    <model name="ground_target_qr_alpha">
      <static>true</static>
      <pose>20 25 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>2.0 2.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>1 0.84 0 1</ambient>
            <diffuse>1 0.84 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
